# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Python legacy (no longer used — kept in docs/legacy/ for reference)
venv/
__pycache__/
*.pyc
.env

# Student data — never commit raw video/photos of students (privacy/consent)
data/raw_videos/*
!data/raw_videos/.gitkeep
data/roster/*
!data/roster/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
*.mp4
*.mov
*.avi
*.jpg
*.jpeg
*.png
!docs/**/*.png
!assets/**/*.png

# Model weights — the 3 MVP models ARE committed (verified, small: ~14.6MB
# total — yunet_int8.onnx ~100KB, haarcascade xml ~930KB,
# arcface_mobilefacenet.onnx ~13.6MB). Only block future large/unverified
# model files by default so nobody accidentally commits a huge one.
*.onnx
*.tflite
*.pt
*.pth
!assets/models/yunet_int8.onnx
!assets/models/retinaface_mobilenet025_int8.onnx
!assets/models/arcface_mobilefacenet.onnx

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Word doc reference copies
*.docx
~$*

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
**/android/key.properties

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
