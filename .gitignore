# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Python legacy (no longer used — kept in docs/legacy/ for reference)
venv/
__pycache__/
*.pyc
.env

# Student data — never commit raw video/photos of students (privacy/consent)
data/raw_videos/*
!data/raw_videos/.gitkeep
data/roster/*
!data/roster/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
*.mp4
*.mov
*.avi
*.jpg
*.jpeg
*.png
!docs/**/*.png
!assets/**/*.png
!ios/Runner/Assets.xcassets/**/*.png
!android/app/src/main/res/**/*.png

# Native third-party binaries (downloaded, not committed to git)
assets/models/*.tflite
*.pt
*.pth
native/third_party/

# ONNX model weights ARE committed, via Git LFS (see .gitattributes) —
# assets/models/*.onnx is tracked so the app works after a fresh clone.

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Word doc reference copies
*.docx
~$*

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
**/android/key.properties

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
